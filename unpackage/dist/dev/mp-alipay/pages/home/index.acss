
.container.data-v-4978fed5 {
  padding-bottom: 140rpx;
}
.container.no-scroll.data-v-4978fed5 {
  overflow: hidden;
  height: 100vh;
}

/* 页面包装器 */
.page-wrapper.data-v-4978fed5 {
  min-height: 100vh;
}
.page-wrapper.no-scroll.data-v-4978fed5 {
  overflow: hidden;
  height: 100vh;
  position: fixed;
  width: 100%;
  top: 0;
  left: 0;
}
.calendar-card.data-v-4978fed5 {
  overflow: hidden;
  transition: none;
}
.calendar-card.data-v-4978fed5:active {
  transform: none;
}
.calendar-header.data-v-4978fed5 {
  margin-bottom: 24rpx;
}
.month-nav.data-v-4978fed5 {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}
.nav-btn.data-v-4978fed5 {
  font-size: 48rpx;
  color: #ff7b8a;
  padding: 0 16rpx;
  font-weight: 300;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.nav-btn.data-v-4978fed5:active {
  transform: scale(0.8);
  opacity: 0.7;
}
.month-title.data-v-4978fed5 {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  min-width: 200rpx;
  text-align: center;
}
.weekdays.data-v-4978fed5 {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #fce7f3;
}
.weekday.data-v-4978fed5 {
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  font-weight: 500;
}
.days-grid.data-v-4978fed5 {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}
.day-item.data-v-4978fed5 {
  position: relative;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  cursor: pointer;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.day-item.data-v-4978fed5:active {
  transform: scale(0.85);
  opacity: 0.8;
}
.day-item.empty.data-v-4978fed5 {
  visibility: hidden;
}
.day-number.data-v-4978fed5 {
  font-size: 28rpx;
  color: #6b7280;
  font-weight: 500;
}
.day-item.today .day-number.data-v-4978fed5 {
  color: #ff7b8a;
  font-weight: 600;
}
.day-item.selected.data-v-4978fed5 {
  background: linear-gradient(135deg, #ff7b8a 0%, #ff9aa2 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 123, 138, 0.3);
}
.day-item.selected .day-number.data-v-4978fed5 {
  color: #fff;
  font-weight: 600;
}
.day-item.has-record:not(.selected) .day-number.data-v-4978fed5 {
  color: #ff6b7a;
  font-weight: 600;
}
.day-dots.data-v-4978fed5 {
  position: absolute;
  bottom: 8rpx;
  display: flex;
  gap: 6rpx;
  justify-content: center;
  left: 50%;
  transform: translateX(-50%);
}
.day-dot.data-v-4978fed5 {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}
.day-dot.normal.data-v-4978fed5 {
  background: linear-gradient(135deg, #ff7b8a 0%, #ff9aa2 100%);
}
.day-dot.future.data-v-4978fed5 {
  background: #9ca3af;
}
.day-item.selected .day-dot.normal.data-v-4978fed5 {
  background: #fff;
}
.section-title.data-v-4978fed5 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 16rpx;
}
.title-text.data-v-4978fed5 {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}
.title-count.data-v-4978fed5 {
  font-size: 26rpx;
  color: #ff7b8a;
  font-weight: 500;
}
.record-list.data-v-4978fed5 {
  margin-bottom: 24rpx;
}
.record-item.data-v-4978fed5 {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 182, 193, 0.12);
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.record-item.data-v-4978fed5:active {
  transform: scale(0.98);
}
.record-left.data-v-4978fed5 {
  flex: 1;
}
.record-time.data-v-4978fed5 {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.time-icon.data-v-4978fed5 {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}
.time-text.data-v-4978fed5 {
  font-size: 28rpx;
  color: #6b7280;
  font-weight: 500;
}
.student-name.data-v-4978fed5 {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 30rpx;
  color: #1f2937;
  font-weight: 600;
}
.name-icon.data-v-4978fed5 {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}
.record-right.data-v-4978fed5 {
  flex-shrink: 0;
  margin-left: 20rpx;
}
.duration-tag.data-v-4978fed5 {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff7b8a 0%, #ff9aa2 100%);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 未来课时样式 */
.future-record.data-v-4978fed5 {
  opacity: 0.6;
}
.future-tag.data-v-4978fed5 {
  font-size: 22rpx;
  color: #9ca3af;
  background: #e5e7eb;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-left: 8rpx;
}
.duration-preview.data-v-4978fed5 {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #ffeef0 0%, #ffe4e9 100%);
  border-radius: 16rpx;
  margin-bottom: 28rpx;
}

/* 时间选择同一行 */
.time-row.data-v-4978fed5 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.time-picker-wrapper.data-v-4978fed5 {
  flex: 1;
}
.time-picker-wrapper picker.data-v-4978fed5 {
  width: 100%;
}
.time-picker.data-v-4978fed5 {
  width: 100%;
  box-sizing: border-box;
}
.time-separator.data-v-4978fed5 {
  font-size: 32rpx;
  color: #9ca3af;
  font-weight: 300;
  flex-shrink: 0;
}
.preview-label.data-v-4978fed5 {
  font-size: 28rpx;
  color: #6b7280;
}
.preview-value.data-v-4978fed5 {
  font-size: 32rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #ff7b8a, #ff6b7a);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 未来课时开关 */
.future-switch.data-v-4978fed5 {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: auto;
}
.future-label.data-v-4978fed5 {
  font-size: 24rpx;
  color: #9ca3af;
}
