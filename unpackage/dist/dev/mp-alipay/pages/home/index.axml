<view class="{{('page-wrapper') + ' ' + 'data-v-4978fed5' + ' ' + (I && 'no-scroll')}}" onTouchMove="{{J}}"><view class="container data-v-4978fed5"><view class="card calendar-card data-v-4978fed5"><view class="calendar-header data-v-4978fed5"><view class="month-nav data-v-4978fed5"><text class="nav-btn data-v-4978fed5" onTap="{{a}}">‹</text><text class="month-title data-v-4978fed5">{{b}}年{{c}}月</text><text class="nav-btn data-v-4978fed5" onTap="{{d}}">›</text></view></view><view class="weekdays data-v-4978fed5"><text a:for="{{e}}" a:for-item="day" a:key="b" class="weekday data-v-4978fed5">{{day.a}}</text></view><view class="days-grid data-v-4978fed5"><view a:for="{{f}}" a:for-item="day" a:key="e" class="{{('day-item') + ' ' + 'data-v-4978fed5' + ' ' + (day.f && 'empty') + ' ' + (day.g && 'today') + ' ' + (day.h && 'selected') + ' ' + (day.i && 'has-record')}}" onTap="{{day.j}}"><text class="day-number data-v-4978fed5">{{day.a}}</text><view a:if="{{day.b}}" class="day-dots data-v-4978fed5"><view a:if="{{day.c}}" class="day-dot normal data-v-4978fed5"></view><view a:if="{{day.d}}" class="day-dot future data-v-4978fed5"></view></view></view></view></view><view a:if="{{g}}" class="section-title data-v-4978fed5"><text class="title-text data-v-4978fed5">{{h}}的课程</text><text class="title-count data-v-4978fed5">{{i}}节</text></view><view a:if="{{j}}" class="record-list data-v-4978fed5"><view a:for="{{k}}" a:for-item="record" a:key="g" class="{{('record-item') + ' ' + 'fade-in' + ' ' + 'data-v-4978fed5' + ' ' + (record.f && 'future-record')}}" onLongTap="{{record.h}}"><view class="record-left data-v-4978fed5"><view class="record-time data-v-4978fed5"><image class="time-icon data-v-4978fed5" src="{{l}}" mode="aspectFit"/><text class="time-text data-v-4978fed5">{{record.a}} - {{record.b}}</text></view><view class="student-name data-v-4978fed5"><image class="name-icon data-v-4978fed5" src="{{m}}" mode="aspectFit"/><text class="data-v-4978fed5">{{record.c}}</text><text a:if="{{record.d}}" class="future-tag data-v-4978fed5">未上课</text></view></view><view class="record-right data-v-4978fed5"><text class="duration-tag data-v-4978fed5">{{record.e}}分钟</text></view></view></view><view a:else class="empty-state fade-in data-v-4978fed5"><text class="empty-text data-v-4978fed5">今天还没有课程记录哦~</text></view><drag-float-btn class="data-v-4978fed5" onClick="{{n}}" u-i="4978fed5-0" onVI="__l"/><popup-modal class="data-v-4978fed5" u-s="{{['d']}}" onClose="{{F}}" onSubmit="{{G}}" u-i="4978fed5-1" onVI="__l" u-p="{{H||''}}"><view class="form-item data-v-4978fed5"><text class="form-label data-v-4978fed5">选择学生</text><picker class="data-v-4978fed5" mode="selector" range="{{p}}" onChange="{{q}}"><view class="picker-value data-v-4978fed5">{{o}} <text class="picker-arrow data-v-4978fed5">›</text></view></picker></view><view class="form-item data-v-4978fed5"><text class="form-label data-v-4978fed5">上课日期</text><picker class="data-v-4978fed5" mode="date" value="{{s}}" onChange="{{t}}"><view class="picker-value data-v-4978fed5">{{r}} <text class="picker-arrow data-v-4978fed5">›</text></view></picker></view><view class="form-item data-v-4978fed5"><text class="form-label data-v-4978fed5">上课时间</text><view class="time-row data-v-4978fed5"><view class="time-picker-wrapper data-v-4978fed5"><picker class="data-v-4978fed5" mode="time" value="{{w}}" onChange="{{x}}"><view class="picker-value time-picker data-v-4978fed5">{{v}} <text class="picker-arrow data-v-4978fed5">›</text></view></picker></view><text class="time-separator data-v-4978fed5">-</text><view class="time-picker-wrapper data-v-4978fed5"><picker class="data-v-4978fed5" mode="time" value="{{z}}" onChange="{{A}}"><view class="picker-value time-picker data-v-4978fed5">{{y}} <text class="picker-arrow data-v-4978fed5">›</text></view></picker></view></view></view><view a:if="{{B}}" class="duration-preview data-v-4978fed5"><text class="preview-label data-v-4978fed5">课时:</text><text class="preview-value data-v-4978fed5">{{C}}分钟</text><view class="future-switch data-v-4978fed5"><switch class="data-v-4978fed5" checked="{{D}}" onChange="{{E}}" color="#ff7b8a" style="transform:scale(0.7)"/><text class="future-label data-v-4978fed5">未上课</text></view></view></popup-modal></view></view>