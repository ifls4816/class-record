
/* 页面包装器 */
.page-wrapper.data-v-c78e6e6b {
  min-height: 100vh;
}
.page-wrapper.no-scroll.data-v-c78e6e6b {
  overflow: hidden;
  height: 100vh;
  position: fixed;
  width: 100%;
  top: 0;
  left: 0;
}
.container.data-v-c78e6e6b {
  padding-bottom: 140rpx;
}

/* 搜索栏 */
.search-bar.data-v-c78e6e6b {
  margin-bottom: 24rpx;
}
.search-input-wrapper.data-v-c78e6e6b {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 182, 193, 0.12);
  gap: 16rpx;
}
.search-icon.data-v-c78e6e6b {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}
.search-input.data-v-c78e6e6b {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
  height: 40rpx;
  line-height: 40rpx;
}
.clear-icon.data-v-c78e6e6b {
  font-size: 36rpx;
  color: #9ca3af;
  padding: 0 8rpx;
  flex-shrink: 0;
}
.student-list.data-v-c78e6e6b {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.student-card.data-v-c78e6e6b {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(255, 182, 193, 0.1);
  display: flex;
  align-items: center;
  gap: 16rpx;
  transition: all 0.3s ease;
}
.student-item:active .student-card.data-v-c78e6e6b {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(255, 182, 193, 0.08);
}
.student-avatar.data-v-c78e6e6b {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff7b8a 0%, #ff9aa2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar-text.data-v-c78e6e6b {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}
.student-info.data-v-c78e6e6b {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.student-name.data-v-c78e6e6b {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.student-date.data-v-c78e6e6b {
  font-size: 22rpx;
  color: #9ca3af;
}

/* 禁用学生区域 */
.disabled-section.data-v-c78e6e6b {
  grid-column: span 2;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f3f4f6;
}
.student-card.disabled.data-v-c78e6e6b {
  opacity: 0.6;
}
.switch-wrapper.data-v-c78e6e6b {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fef1f2;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.switch-wrapper.data-v-c78e6e6b:active {
  transform: scale(0.98);
  opacity: 0.85;
}
.switch-text.data-v-c78e6e6b {
  font-size: 30rpx;
  color: #1f2937;
}

/* 统计信息样式 */
.stats-info.data-v-c78e6e6b {
  background: #fef1f2;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
}
.stats-row.data-v-c78e6e6b {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}
.stats-row.data-v-c78e6e6b:not(:last-child) {
  border-bottom: 1rpx solid rgba(255, 123, 138, 0.15);
}
.stats-label.data-v-c78e6e6b {
  font-size: 28rpx;
  color: #6b7280;
}
.stats-value.data-v-c78e6e6b {
  font-size: 30rpx;
  font-weight: 600;
  color: #ff7b8a;
}
