
/* 页面包装器 */
.page-wrapper.data-v-49fa13a1 {
  min-height: 100vh;
}
.page-wrapper.no-scroll.data-v-49fa13a1 {
  overflow: hidden;
  height: 100vh;
  position: fixed;
  width: 100%;
  top: 0;
  left: 0;
}
.container.data-v-49fa13a1 {
  padding-bottom: 40rpx;
}

/* 头部卡片 */
.header-card.data-v-49fa13a1 {
  background: linear-gradient(135deg, #ff7b8a 0%, #ff9aa2 100%);
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 123, 138, 0.35);
}
.header-top.data-v-49fa13a1 {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.nav-btn.data-v-49fa13a1 {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  transition: transform 0.15s ease, background 0.15s ease, opacity 0.15s ease;
}
.nav-btn.data-v-49fa13a1:active {
  transform: scale(0.85);
  background: rgba(255, 255, 255, 0.4);
  opacity: 0.9;
}
.nav-arrow.data-v-49fa13a1 {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  line-height: 1;
}
.current-period.data-v-49fa13a1 {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s ease;
}
.current-period.data-v-49fa13a1:active {
  opacity: 0.7;
}
.period-text.data-v-49fa13a1 {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}
.header-divider.data-v-49fa13a1 {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 16rpx 0;
}
.header-bottom.data-v-49fa13a1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.total-label.data-v-49fa13a1 {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}
.total-value-wrap.data-v-49fa13a1 {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}
.total-value.data-v-49fa13a1 {
  font-size: 40rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1;
}
.total-unit.data-v-49fa13a1 {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}
.ranking-section.data-v-49fa13a1 {
  margin-top: 16rpx;
}
.teacher-group.data-v-49fa13a1 {
  margin-bottom: 32rpx;
}
.group-title.data-v-49fa13a1 {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}
.teacher-name.data-v-49fa13a1 {
  color: #1f2937;
}
.teacher-hours.data-v-49fa13a1 {
  color: #ff6b7a;
}
.ranking-list.data-v-49fa13a1 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.ranking-item.data-v-49fa13a1 {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 182, 193, 0.12);
  transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
}
.ranking-item.data-v-49fa13a1:active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 8rpx rgba(255, 182, 193, 0.08);
  opacity: 0.85;
}
.rank-info.data-v-49fa13a1 {
  text-align: center;
}
.rank-name.data-v-49fa13a1 {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-time.data-v-49fa13a1 {
  font-size: 24rpx;
  color: #ff6b7a;
  font-weight: 600;
}
.empty-state.data-v-49fa13a1 {
  padding: 80rpx 40rpx;
}

/* 学生详情弹窗 */
.detail-header.data-v-49fa13a1 {
  margin-bottom: 20rpx;
}
.detail-subtitle.data-v-49fa13a1 {
  font-size: 28rpx;
  color: #ff6b7a;
  font-weight: 500;
}
.detail-list.data-v-49fa13a1 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}
.detail-item.data-v-49fa13a1 {
  background: linear-gradient(135deg, #fef1f2 0%, #fff5f6 100%);
  border-radius: 16rpx;
  padding: 16rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  border-left: 4rpx solid #ff6b7a;
}
.detail-date.data-v-49fa13a1 {
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2937;
}
.detail-time.data-v-49fa13a1 {
  font-size: 20rpx;
  color: #9ca3af;
}
.detail-hours.data-v-49fa13a1 {
  font-size: 22rpx;
  color: #ff6b7a;
  font-weight: 600;
}
.empty-detail.data-v-49fa13a1 {
  padding: 80rpx 0;
  text-align: center;
}
.empty-detail .empty-text.data-v-49fa13a1 {
  color: #9ca3af;
  font-size: 28rpx;
}
