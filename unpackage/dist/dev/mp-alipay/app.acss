
/* 全局样式 */
page {
  background: linear-gradient(135deg, #fef1f2 0%, #fdf2f8 50%, #f5f3ff 100%);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* 弹窗打开时禁止页面滚动 */
page.no-scroll {
  overflow: hidden;
  height: 100vh;
}

/* 全局容器 */
.container {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 卡片基础样式 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 182, 193, 0.15);
  transition: all 0.3s ease;
}
.card:active {
  transform: scale(0.98);
}

/* 渐变按钮 */
.btn-gradient {
  background: linear-gradient(135deg, #ff7b8a 0%, #ff9aa2 100%);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(255, 154, 158, 0.4);
  transition: all 0.3s ease;
}
.btn-gradient:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(255, 154, 158, 0.3);
}

/* 次级按钮 */
.btn-secondary {
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
  color: #666;
  border: none;
  border-radius: 50rpx;
  font-size: 30rpx;
  box-shadow: 0 6rpx 16rpx rgba(168, 237, 234, 0.3);
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}
.tag-pink {
  background: linear-gradient(135deg, #ffeef0 0%, #ffe4e9 100%);
  color: #ff6b7a;
}
.tag-purple {
  background: linear-gradient(135deg, #f3e8ff 0%, #e9d5ff 100%);
  color: #a855f7;
}
.tag-mint {
  background: linear-gradient(135deg, #e0f7f4 0%, #d1fae5 100%);
  color: #10b981;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #fce7f3, transparent);
  margin: 24rpx 0;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #d1d5db;
}
.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}

/* 输入框样式 */
.input-wrapper {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #fce7f3;
  transition: all 0.3s ease;
}
.input-wrapper:focus-within {
  border-color: #ff9a9e;
  box-shadow: 0 0 0 4rpx rgba(255, 154, 158, 0.1);
}

/* 浮动按钮 */
.floating-btn {
  position: fixed;
  right: 40rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff7b8a 0%, #ff9aa2 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 123, 138, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  transition: all 0.3s ease;
}
.floating-btn:active {
  transform: scale(0.9);
}

/* 表单样式 */
.form-item {
  margin-bottom: 28rpx;
}
.form-label {
  display: block;
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.picker-value {
  background: #fef1f2;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: #1f2937;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.picker-value:active {
  transform: scale(0.98);
  opacity: 0.85;
}
.picker-arrow {
  color: #ff7b8a;
  font-size: 32rpx;
}
.input-field {
  background: #fef1f2;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #1f2937;
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.input-field:focus {
  transform: scale(0.98);
  opacity: 0.9;
}
.input-placeholder {
  color: #9ca3af;
}

/* 统计卡片 */
.stat-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 182, 193, 0.2);
}
.stat-number {
  font-size: 56rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #ff7b8a, #ff6b7a);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.stat-label {
  font-size: 26rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

/* 列表项 */
.list-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 182, 193, 0.12);
  transition: all 0.3s ease;
}
.list-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(255, 182, 193, 0.08);
}

/* 加载动画 */
@keyframes fadeIn {
from {
    opacity: 0;
    transform: translateY(20rpx);
}
to {
    opacity: 1;
    transform: translateY(0);
}
}
.fade-in {
  animation: fadeIn 0.3s ease;
}

/* 数字动画 */
@keyframes countUp {
from {
    opacity: 0;
    transform: scale(0.5);
}
to {
    opacity: 1;
    transform: scale(1);
}
}
.count-up {
  animation: countUp 0.5s ease;
}

/* 文字渐变 */
.text-gradient {
  background: linear-gradient(135deg, #ff7b8a, #ff9aa2, #a8edea);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}