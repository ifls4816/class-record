.page-wrapper.data-v-35308726{min-height:100vh}.page-wrapper.no-scroll.data-v-35308726{overflow:hidden;height:100vh;position:fixed;width:100%;top:0;left:0}.container.data-v-35308726{padding-bottom:140rpx}.search-bar.data-v-35308726{margin-bottom:24rpx}.search-input-wrapper.data-v-35308726{display:flex;align-items:center;background:#fff;border-radius:24rpx;padding:20rpx 28rpx;box-shadow:0 4rpx 16rpx rgba(255,182,193,.12);gap:16rpx}.search-icon.data-v-35308726{width:36rpx;height:36rpx;flex-shrink:0}.search-input.data-v-35308726{flex:1;font-size:28rpx;color:#1f2937;height:40rpx;line-height:40rpx}.clear-icon.data-v-35308726{font-size:36rpx;color:#9ca3af;padding:0 8rpx;flex-shrink:0}.student-list.data-v-35308726{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx;margin-bottom:24rpx}.student-card.data-v-35308726{background:#fff;border-radius:20rpx;padding:20rpx;box-shadow:0 2rpx 12rpx rgba(255,182,193,.1);display:flex;align-items:center;gap:16rpx;transition:all .3s ease}.student-item:active .student-card.data-v-35308726{transform:scale(.96);box-shadow:0 2rpx 8rpx rgba(255,182,193,.08)}.student-avatar.data-v-35308726{width:72rpx;height:72rpx;border-radius:50%;background:linear-gradient(135deg,#ff7b8a,#ff9aa2);display:flex;align-items:center;justify-content:center;flex-shrink:0}.avatar-text.data-v-35308726{color:#fff;font-size:32rpx;font-weight:600}.student-info.data-v-35308726{flex:1;min-width:0;display:flex;flex-direction:column;gap:4rpx}.student-name.data-v-35308726{font-size:28rpx;font-weight:600;color:#1f2937;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.student-date.data-v-35308726{font-size:22rpx;color:#9ca3af}.disabled-section.data-v-35308726{grid-column:span 2;display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx;margin-top:16rpx;padding-top:16rpx;border-top:2rpx solid #f3f4f6}.student-card.disabled.data-v-35308726{opacity:.6}.switch-wrapper.data-v-35308726{display:flex;align-items:center;gap:16rpx;background:#fef1f2;border-radius:16rpx;padding:24rpx 28rpx;transition:transform .15s ease,opacity .15s ease}.switch-wrapper.data-v-35308726:active{transform:scale(.98);opacity:.85}.switch-text.data-v-35308726{font-size:30rpx;color:#1f2937}.stats-info.data-v-35308726{background:#fef1f2;border-radius:16rpx;padding:20rpx 28rpx}.stats-row.data-v-35308726{display:flex;justify-content:space-between;align-items:center;padding:12rpx 0}.stats-row.data-v-35308726:not(:last-child){border-bottom:1rpx solid rgba(255,123,138,.15)}.stats-label.data-v-35308726{font-size:28rpx;color:#6b7280}.stats-value.data-v-35308726{font-size:30rpx;font-weight:600;color:#ff7b8a}
