<view class="{{('page-wrapper') + ' ' + 'data-v-46c0eda0' + ' ' + (n && 'no-scroll')}}" onTouchMove="{{o}}"><view class="container data-v-46c0eda0"><view class="header-card fade-in data-v-46c0eda0"><view class="header-top data-v-46c0eda0"><view class="nav-btn data-v-46c0eda0" onTap="{{a}}"><text class="nav-arrow data-v-46c0eda0">‹</text></view><view class="current-period data-v-46c0eda0" onTap="{{c}}"><text class="period-text data-v-46c0eda0">{{b}}</text></view><view class="nav-btn data-v-46c0eda0" onTap="{{d}}"><text class="nav-arrow data-v-46c0eda0">›</text></view></view><view class="header-divider data-v-46c0eda0"></view><view class="header-bottom data-v-46c0eda0"><text class="total-label data-v-46c0eda0">总课时</text><view class="total-value-wrap data-v-46c0eda0"><text class="total-value data-v-46c0eda0">{{e}}</text><text class="total-unit data-v-46c0eda0">小时</text></view></view></view><view class="ranking-section data-v-46c0eda0"><view a:if="{{f}}" class="data-v-46c0eda0"><view a:for="{{g}}" a:for-item="group" a:key="d" class="teacher-group data-v-46c0eda0"><view class="group-title data-v-46c0eda0"><text class="teacher-name data-v-46c0eda0">{{group.a}}</text><text class="teacher-hours data-v-46c0eda0"> · {{group.b}}小时</text></view><view class="ranking-list data-v-46c0eda0"><view a:for="{{group.c}}" a:for-item="item" a:key="c" class="ranking-item fade-in data-v-46c0eda0" onTap="{{item.d}}"><view class="rank-info data-v-46c0eda0"><text class="rank-name data-v-46c0eda0">{{item.a}}</text><text class="rank-time data-v-46c0eda0">{{item.b}}小时</text></view></view></view></view></view><view a:else class="empty-state fade-in data-v-46c0eda0"><text class="empty-text data-v-46c0eda0">暂无数据统计</text></view></view><popup-modal class="data-v-46c0eda0" u-s="{{['d']}}" onClose="{{k}}" onSubmit="{{l}}" u-i="46c0eda0-0" onVI="__l" u-p="{{m||''}}"><view class="detail-header data-v-46c0eda0"><text class="detail-subtitle data-v-46c0eda0">共 {{h}} 小时</text></view><view a:if="{{i}}" class="detail-list data-v-46c0eda0"><view a:for="{{j}}" a:for-item="record" a:key="e" class="detail-item data-v-46c0eda0"><text class="detail-date data-v-46c0eda0">{{record.a}}</text><text class="detail-time data-v-46c0eda0">{{record.b}}-{{record.c}}</text><text class="detail-hours data-v-46c0eda0">{{record.d}}小时</text></view></view><view a:else class="empty-detail data-v-46c0eda0"><text class="empty-text data-v-46c0eda0">暂无课时记录</text></view></popup-modal></view></view>