page{background:linear-gradient(135deg,#fef1f2,#fdf2f8,#f5f3ff);min-height:100vh;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,PingFang SC,Hiragino Sans GB,Microsoft YaHei,sans-serif}page.no-scroll{overflow:hidden;height:100vh}.container{padding:24rpx;padding-bottom:calc(24rpx + env(safe-area-inset-bottom))}.card{background:#fff;border-radius:24rpx;padding:32rpx;margin-bottom:24rpx;box-shadow:0 4rpx 20rpx rgba(255,182,193,.15);transition:all .3s ease}.card:active{transform:scale(.98)}.btn-gradient{background:linear-gradient(135deg,#ff7b8a,#ff9aa2);color:#fff;border:none;border-radius:50rpx;font-size:32rpx;font-weight:500;box-shadow:0 8rpx 24rpx rgba(255,154,158,.4);transition:all .3s ease}.btn-gradient:active{transform:scale(.95);box-shadow:0 4rpx 12rpx rgba(255,154,158,.3)}.btn-secondary{background:linear-gradient(135deg,#a8edea,#fed6e3);color:#666;border:none;border-radius:50rpx;font-size:30rpx;box-shadow:0 6rpx 16rpx rgba(168,237,234,.3)}.tag{display:inline-block;padding:8rpx 20rpx;border-radius:20rpx;font-size:24rpx;font-weight:500}.tag-pink{background:linear-gradient(135deg,#ffeef0,#ffe4e9);color:#ff6b7a}.tag-purple{background:linear-gradient(135deg,#f3e8ff,#e9d5ff);color:#a855f7}.tag-mint{background:linear-gradient(135deg,#e0f7f4,#d1fae5);color:#10b981}.divider{height:1rpx;background:linear-gradient(90deg,transparent,#fce7f3,transparent);margin:24rpx 0}.empty-state{text-align:center;padding:80rpx 40rpx;color:#d1d5db}.empty-icon{font-size:120rpx;margin-bottom:24rpx}.empty-text{font-size:28rpx;color:#9ca3af}.input-wrapper{background:#fff;border-radius:16rpx;padding:24rpx 32rpx;margin-bottom:24rpx;border:2rpx solid #fce7f3;transition:all .3s ease}.input-wrapper:focus-within{border-color:#ff9a9e;box-shadow:0 0 0 4rpx rgba(255,154,158,.1)}.floating-btn{position:fixed;right:40rpx;bottom:calc(140rpx + env(safe-area-inset-bottom));width:100rpx;height:100rpx;border-radius:50%;background:linear-gradient(135deg,#ff7b8a,#ff9aa2);box-shadow:0 8rpx 24rpx rgba(255,123,138,.5);display:flex;align-items:center;justify-content:center;z-index:100;transition:all .3s ease}.floating-btn:active{transform:scale(.9)}.form-item{margin-bottom:28rpx}.form-label{display:block;font-size:28rpx;color:#6b7280;margin-bottom:12rpx;font-weight:500}.picker-value{background:#fef1f2;border-radius:16rpx;padding:24rpx 28rpx;font-size:30rpx;color:#1f2937;display:flex;align-items:center;justify-content:space-between;transition:transform .15s ease,opacity .15s ease}.picker-value:active{transform:scale(.98);opacity:.85}.picker-arrow{color:#ff7b8a;font-size:32rpx}.input-field{background:#fef1f2;border-radius:16rpx;padding:0 28rpx;font-size:30rpx;color:#1f2937;width:100%;height:88rpx;box-sizing:border-box;line-height:88rpx;display:flex;align-items:center;transition:transform .15s ease,opacity .15s ease}.input-field:focus{transform:scale(.98);opacity:.9}.input-placeholder{color:#9ca3af}.stat-card{background:#fff;border-radius:24rpx;padding:32rpx;margin-bottom:24rpx;box-shadow:0 4rpx 20rpx rgba(255,182,193,.2)}.stat-number{font-size:56rpx;font-weight:600;background:linear-gradient(135deg,#ff7b8a,#ff6b7a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}.stat-label{font-size:26rpx;color:#9ca3af;margin-top:8rpx}.list-item{background:#fff;border-radius:20rpx;padding:28rpx 32rpx;margin-bottom:20rpx;box-shadow:0 4rpx 16rpx rgba(255,182,193,.12);transition:all .3s ease}.list-item:active{transform:scale(.98);box-shadow:0 2rpx 8rpx rgba(255,182,193,.08)}@keyframes fadeIn{0%{opacity:0;transform:translateY(20rpx)}to{opacity:1;transform:translateY(0)}}.fade-in{animation:fadeIn .3s ease}@keyframes countUp{0%{opacity:0;transform:scale(.5)}to{opacity:1;transform:scale(1)}}.count-up{animation:countUp .5s ease}.text-gradient{background:linear-gradient(135deg,#ff7b8a,#ff9aa2,#a8edea);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
page::after{position:fixed;content:'';left:-1000px;top:-1000px;-webkit-animation:shadow-preload .1s;-webkit-animation-delay:3s;animation:shadow-preload .1s;animation-delay:3s}@-webkit-keyframes shadow-preload{0%{background-image:url(https://cdn2.dcloud.net.cn/52444178525552464d53556c4d6a41794d5441774d7a45794f44597a4f5467354f513d3d/img/shadow-grey.png)}100%{background-image:url(https://cdn2.dcloud.net.cn/52444178525552464d53556c4d6a41794d5441774d7a45794f44597a4f5467354f513d3d/img/shadow-grey.png)}}@keyframes shadow-preload{0%{background-image:url(https://cdn2.dcloud.net.cn/52444178525552464d53556c4d6a41794d5441774d7a45794f44597a4f5467354f513d3d/img/shadow-grey.png)}100%{background-image:url(https://cdn2.dcloud.net.cn/52444178525552464d53556c4d6a41794d5441774d7a45794f44597a4f5467354f513d3d/img/shadow-grey.png)}}page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}